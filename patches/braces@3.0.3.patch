diff --git a/lib/depth-guard.js b/lib/depth-guard.js
new file mode 100644
index 0000000000000000000000000000000000000000..ba30597369466b76674863c3662ab2a098ca9fa3
--- /dev/null
+++ b/lib/depth-guard.js
@@ -0,0 +1,22 @@
+'use strict';
+
+const MAX_DEPTH = 64;
+
+// Validate iteratively before any recursive walker, including caller-supplied ASTs.
+const assertDepth = ast => {
+  const pending = [[ast, 0]];
+  const seen = new Set();
+  while (pending.length) {
+    const [node, depth] = pending.pop();
+    if (!node || typeof node !== 'object') continue;
+    if (depth > MAX_DEPTH || seen.has(node)) {
+      throw new SyntaxError('Brace AST exceeds safe nesting depth or contains repeated nodes');
+    }
+    seen.add(node);
+    if (Array.isArray(node.nodes)) {
+      for (const child of node.nodes) pending.push([child, depth + 1]);
+    }
+  }
+};
+
+module.exports = { MAX_DEPTH, assertDepth };
