{
  "productName": "HyesRead",
  "version": "0.1.9",
  "identifier": "com.hyes.read",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "HyesRead",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; frame-src 'self' blob:; connect-src 'self' http://* https://* ws://* wss://*; img-src 'self' data: blob:; media-src 'self' data: blob: http://* https://*;",
      "dangerousDisableAssetCspModification": ["style-src"],
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "fileAssociations": [
      {
        "ext": ["epub", "mobi", "azw3", "kf8", "pdf", "cbz", "txt", "md", "fb2", "fbz"],
        "name": "E-book Document",
        "description": "Electronic book file managed by HyesRead",
        "role": "Viewer"
      }
    ]
  }
}
